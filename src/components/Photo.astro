---
import { Picture } from "astro-lqip/components";
import type { HTMLAttributes } from "astro/types";
import OutLink from "@components/OutLink.astro";
import type { ImageMetadata } from "astro";
import ExifReader from "exifreader";
import fs from "node:fs/promises";
import path from "path";
import { fileURLToPath } from "node:url";

interface Props extends HTMLAttributes<"picture"> {
  src: string;
  alt: string;
  location?: string;
}

const { src, alt, location, ...attrs } = Astro.props;

const imageGlob = import.meta.glob<{ default: ImageMetadata }>(
  "@assets/photos/*",
);

if (!imageGlob[src]) {
  throw new Error(`"${src}" does not exist"`);
}

const { default: resolvedImage } = await imageGlob[src]();

const fullSizeUrl = resolvedImage.src;

const { $id } = Astro.locals;
const dialogId = $id("dialog");

// exif
const imagePath = path.join(
  process.cwd(),
  fileURLToPath(new URL(src, import.meta.url)),
);
const fileBuffer = await fs.readFile(imagePath);
const tags = ExifReader.load(fileBuffer);

const make = tags["Make"]?.description;
const model = tags["Model"]?.description;
const dateTime = tags["DateTimeOriginal"]?.description;
const focalLength = tags["FocalLengthIn35mmFilm"]?.description;
const aperture = tags["FNumber"]?.description;
const exposure = tags["ExposureTime"]?.description;
const iso = tags["ISOSpeedRatings"]?.description;
const lensInfo = tags["LensSpecification"]?.description;

const exifData = {
  Camera: make + " " + model,
  DateTimeOriginal: dateTime,
  FocalLength: focalLength,
  Aperture: aperture,
  Exposure: exposure,
  ISO: iso,
  LensInfo: lensInfo,
};
---

<script is:inline>
  function modal_click(id) {
    document.getElementById(id).showModal();
  }
</script>

<div
  class="cursor-pointer leading-0 rounded-lg overflow-hidden text-transparent"
  onclick={"modal_click('" + dialogId + "');"}
>
  <Picture src={resolvedImage} alt={alt} formats={["avif", "webp"]} />
</div>

<dialog id={dialogId} class="modal">
  <div class="modal-box p-10 card bg-base-100 shadow-sm">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">
        ✕
      </button>
    </form>
    <OutLink
      class="leading-0 rounded-lg overflow-hidden text-transparent"
      href={fullSizeUrl}
    >
      <Picture src={resolvedImage} alt={alt} formats={["avif", "webp"]} />
    </OutLink>
    <div class="card-body p-0 pt-6">
      <h2 class="card-title">{alt}</h2>
      {location && <div class="card-side text-md font-mono">{location}</div>}
      <div class="card-side text-md font-mono mb-1">
        {exifData.DateTimeOriginal}
      </div>
      <div class="card-actions justify-left font-mono">
        <div class="badge badge-outline">ISO {exifData.ISO}</div>
        <div class="badge badge-outline">{exifData.FocalLength}</div>
        <div class="badge badge-outline">{exifData.Aperture}</div>
        <div class="badge badge-outline">{exifData.Exposure}sec</div>
        <div class="badge badge-outline">{exifData.LensInfo}</div>
        <div class="badge badge-outline">{exifData.Camera}</div>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button class="cursor-auto">close</button>
  </form>
</dialog>
