---
import ThemeToggle from "@components/ThemeToggle.svelte";

interface NavItem {
  path: string;
  name: string;
}

const navItems: NavItem[] = [
  {
    path: "/",
    name: "About",
  },
  {
    path: "/photography",
    name: "Photography",
  },
  {
    path: "/projects",
    name: "Projects",
  },
];

const path = Astro.props.path as string;
function normalizePath(path: string): string {
  if (path === "/") {
    return "/";
  }
  return path.replace(/\/$/, "");
}
---

<div class="navbar bg-base-100 shadow-sm shrink-0 font-mono font-bold">
  <div class="flex-1">
    <a class="btn btn-ghost text-xl" href="/">
      elena.sh
    </a>
  </div>
  <div class="flex-none">
    <ul class="menu menu-horizontal px-1 flex items-center justify-center gap-4">
      <ThemeToggle client:load />
      {navItems.map((item) => (
        <a href={item.path}>
          <button
            class:list={[
              "btn",
              "btn-accent",
              normalizePath(path) != normalizePath(item.path)
                ? "btn-outline hidden sm:block"
                : "",
            ]}
          >
            {item.name}
          </button>
        </a>
      ))}
    </ul>
  </div>
</div>
