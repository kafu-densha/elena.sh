---
import Layout from "@layouts/Layout.astro";
import Photo from "@components/Photo.astro";

function genPath(name: string) {
  return "/src/assets/photos/" + name;
}

interface ImageInfo {
  src: string;
  alt: string;
  location?: string;
}

const images: ImageInfo[] = [
  {
    src: genPath("DSC05223.jpg"),
    alt: "Marunouchi line crossing the Kanda River",
    location: "Ochanomizu - Tokyo, Japan",
  },
  // {
  //   src: genPath("DSC05223.jpg"),
  //   alt: "train!!!",
  // },
];
---

<Layout>
  <div class="hero bg-base-200 flex-1 overflow-y-auto">
    <div class="hero-content">
      <div class="max-w-2xl">
        <div class="bg-base-100 rounded-lg p-6 text-center">
          <h1 class="text-4xl md:text-5xl font-bold font-mono text-nowrap">
            Photography
          </h1>
        </div>

        <div class="mt-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {images.map((image) => (
              <Photo {...image} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
