---
import Layout from "@layouts/Layout.astro";
import Photo from "@components/Photo.astro";

function genPath(name: string) {
  return "/src/assets/photos/" + name;
}

interface ImageInfo {
  src: string;
  alt: string;
  location?: string;
}

const images: ImageInfo[] = [
  {
    src: genPath("DSC05223.jpg"),
    alt: "Marunouchi line crossing the Kanda River",
    location: "Ochanomizu - Tokyo, Japan",
  },
  {
    src: genPath("DSC02515.jpg"),
    alt: "Nob Hill View",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC02506.jpg"),
    alt: "Bay Bridge from Nob Hill",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC02418.jpg"),
    alt: "Golden Gate Bridge from Marshall's Beach",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC02282.jpg"),
    alt: "Golden Gate Bridge from Marshall's Beach",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC02199.jpg"),
    alt: "Golden Gate Bridge from Marshall's Beach",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC01740.jpg"),
    alt: "Golden Gate Bridge from Marshall's Beach",
    location: "San Fransisco, CA",
  },
  {
    src: genPath("DSC01642.jpg"),
    alt: "Japanese Tea Gardens",
    location: "Golden Gate Park - San Fransisco, CA",
  },
  {
    src: genPath("DSC01626.jpg"),
    alt: "Japanese Tea Gardens",
    location: "Golden Gate Park - San Fransisco, CA",
  },
  {
    src: genPath("DSC01570.jpg"),
    alt: "Japanese Tea Gardens",
    location: "Golden Gate Park - San Fransisco, CA",
  },
];
---

<Layout>
  <div class="max-w-9/12">
    <div class="bg-base-100 rounded-lg p-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold font-mono text-nowrap">
        Photography
      </h1>
    </div>

    <div class="mt-6 columns-1 md:columns-2 xl:columns-3 gap-6 space-y-6">
      {images.map((image) => (
        <div class="break-inside-avoid overflow-hidden rounded-lg">
          <Photo {...image} />
        </div>
      ))}
    </div>
  </div>
</Layout>
