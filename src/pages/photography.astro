    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <div class="bg-base-100 rounded-lg p-6">
          <h1 class="text-4xl md:text-5xl font-bold font-mono text-nowrap">
            Photography
          </h1>
        </div>

        <div class="mt-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
            <Photo src={trainPhoto} alt="train :)" />
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
